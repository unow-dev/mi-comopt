{
  "name": "workspace",
  "private": true,
  "workspaces": ["package"],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm --workspace package run build",
    "test": "npm --workspace package run test",
    "verify:data": "npm --workspace package run verify:data",
    "verify:release": "npm --workspace package run verify:release",
    "create:data-release": "npm --workspace package run create:data-release --",
    "publish:joint-data": "npm --workspace package run publish:joint-data --",
    "verify:deployed-release": "npm --workspace package run verify:deployed-release --",
    "account-candidate-workflow": "npm --workspace package run account-candidate-workflow --",
    "comment-db": "npm --workspace package run comment-db --",
    "clean": "npm --workspace package run clean"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "@types/node": "^24.0.0"
  }
}
