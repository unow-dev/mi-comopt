{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "workset_id",
    "decisions"
  ],
  "additionalProperties": false,
  "properties": {
    "workset_id": {
      "const": "<WORKSET_ID>"
    },
    "decisions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^I[1-9][0-9]*$"
      },
      "additionalProperties": {
        "enum": [
          "direct_nuisance",
          "reactive",
          "normal"
        ]
      }
    }
  }
}
