{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deployment-completed-event.schema.json",
  "title": "DeploymentCompletedEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventType",
    "correlationKey",
    "payload"
  ],
  "properties": {
    "eventType": {
      "const": "deployment.completed"
    },
    "correlationKey": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deploymentRequestId",
        "target",
        "releaseId",
        "status",
        "externalRunRef",
        "completedAt"
      ],
      "properties": {
        "deploymentRequestId": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "const": "production"
        },
        "releaseId": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "externalRunRef": {
          "type": "string",
          "minLength": 1
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
