{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/candidate-keywords/candidate-view.schema.json",
  "title": "Candidate view for external LLM boundary",
  "type": "object",
  "required": [
    "schema_version",
    "candidates"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "candidate_id",
          "status",
          "keyword",
          "variants",
          "category_id"
        ],
        "properties": {
          "candidate_id": {
            "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/candidate_id"
          },
          "keyword": {
            "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
          },
          "variants": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
            }
          },
          "category_id": {
            "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/category_id"
          },
          "status": {
            "enum": [
              "active",
              "retired"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
