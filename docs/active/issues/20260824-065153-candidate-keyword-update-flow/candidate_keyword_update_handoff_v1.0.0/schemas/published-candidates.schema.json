{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/candidate-keywords/published-candidates.schema.json",
  "title": "Published filter keyword candidates",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "candidate_id",
      "keyword",
      "variants",
      "category_id",
      "category",
      "recommendation",
      "match_type",
      "direct_nuisance_hits",
      "reactive_hits",
      "normal_hits",
      "precision_excluding_reactive",
      "direct_recall_contribution",
      "normal_hit_rate",
      "utility_score",
      "introduced_at"
    ],
    "properties": {
      "candidate_id": {
        "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/candidate_id"
      },
      "keyword": {
        "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
      },
      "variants": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
        }
      },
      "category_id": {
        "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/category_id"
      },
      "category": {
        "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
      },
      "recommendation": {
        "enum": [
          "高推奨",
          "中推奨",
          "任意"
        ]
      },
      "match_type": {
        "const": "normalized_substring"
      },
      "direct_nuisance_hits": {
        "type": "integer",
        "minimum": 1
      },
      "reactive_hits": {
        "type": "integer",
        "minimum": 0
      },
      "normal_hits": {
        "type": "integer",
        "minimum": 0
      },
      "precision_excluding_reactive": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "direct_recall_contribution": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "normal_hit_rate": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      },
      "utility_score": {
        "type": "integer"
      },
      "introduced_at": {
        "oneOf": [
          {
            "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/timestamp"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "additionalProperties": false
  }
}
