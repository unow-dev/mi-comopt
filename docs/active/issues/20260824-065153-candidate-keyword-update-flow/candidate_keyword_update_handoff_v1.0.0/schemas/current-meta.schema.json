{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/candidate-keywords/current-meta.schema.json",
  "title": "Current published candidate metadata",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "run_manifest_content_sha256",
    "published_at",
    "candidates_content_sha256",
    "registry_content_sha256",
    "dataset_artifact_sha256",
    "evaluation_policy_version",
    "evaluation_policy_content_sha256",
    "taxonomy_version",
    "taxonomy_content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/run_id"
    },
    "run_manifest_content_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "published_at": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/timestamp"
    },
    "candidates_content_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "registry_content_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "dataset_artifact_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "evaluation_policy_version": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_policy_content_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "taxonomy_version": {
      "type": "string",
      "minLength": 1
    },
    "taxonomy_content_sha256": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    }
  },
  "additionalProperties": false
}
