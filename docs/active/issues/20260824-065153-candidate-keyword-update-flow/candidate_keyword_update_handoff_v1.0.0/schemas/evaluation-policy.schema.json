{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/candidate-keywords/evaluation-policy.schema.json",
  "title": "Candidate evaluation policy",
  "type": "object",
  "required": [
    "schema_version",
    "policy_version",
    "input",
    "normalization",
    "matching",
    "metrics",
    "recommendation_tiers",
    "publication",
    "sorting",
    "serialization"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "input": {
      "type": "object"
    },
    "normalization": {
      "type": "object"
    },
    "matching": {
      "type": "object"
    },
    "metrics": {
      "type": "object"
    },
    "recommendation_tiers": {
      "type": "array"
    },
    "publication": {
      "type": "object"
    },
    "sorting": {
      "type": "array"
    },
    "serialization": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
