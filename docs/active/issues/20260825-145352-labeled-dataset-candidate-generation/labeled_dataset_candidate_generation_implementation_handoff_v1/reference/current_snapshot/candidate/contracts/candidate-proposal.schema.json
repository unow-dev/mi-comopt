{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.invalid/candidate-keywords/candidate-proposal.schema.json",
  "title": "External LLM candidate proposal",
  "type": "object",
  "required": [
    "schema_version",
    "request_id",
    "input_fingerprint",
    "actions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/request_id"
    },
    "input_fingerprint": {
      "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/sha256"
    },
    "actions": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "action",
              "keyword",
              "variants",
              "category_id"
            ],
            "properties": {
              "action": {
                "const": "add"
              },
              "keyword": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
              },
              "variants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
                }
              },
              "category_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/category_id"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "candidate_id",
              "keyword",
              "variants",
              "category_id"
            ],
            "properties": {
              "action": {
                "const": "update"
              },
              "candidate_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/candidate_id"
              },
              "keyword": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
              },
              "variants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
                }
              },
              "category_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/category_id"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "candidate_id"
            ],
            "properties": {
              "action": {
                "const": "retire"
              },
              "candidate_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/candidate_id"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "action",
              "candidate_id",
              "keyword",
              "variants",
              "category_id"
            ],
            "properties": {
              "action": {
                "const": "reactivate"
              },
              "candidate_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/candidate_id"
              },
              "keyword": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
              },
              "variants": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/nonempty_string"
                }
              },
              "category_id": {
                "$ref": "https://contracts.invalid/candidate-keywords/common.schema.json#/$defs/category_id"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
