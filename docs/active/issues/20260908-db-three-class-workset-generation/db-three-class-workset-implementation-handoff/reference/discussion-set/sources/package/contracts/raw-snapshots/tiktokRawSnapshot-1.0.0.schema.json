{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/tiktok-filter-keywords/raw-snapshot.schema.json",
  "title": "TikTok Raw Snapshot",
  "description": "TikTokから取得した動画、投稿者、統計情報およびコメント一覧を保持するraw snapshot。schemaVersionは契約管理用に追加した項目であり、それ以外の取得項目は取得結果を保持する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "extractedAt",
    "source",
    "video",
    "stats",
    "author",
    "music",
    "hashtags",
    "hashtagDetails",
    "mentions",
    "effects",
    "stickers",
    "comments"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "extractedAt": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "video": {
      "$ref": "#/$defs/video"
    },
    "stats": {
      "$ref": "#/$defs/videoStats"
    },
    "author": {
      "$ref": "#/$defs/author"
    },
    "music": {
      "anyOf": [
        {
          "$ref": "#/$defs/music"
        },
        {
          "type": "null"
        }
      ]
    },
    "hashtags": {
      "type": "array",
      "items": {}
    },
    "hashtagDetails": {
      "type": "array",
      "items": {}
    },
    "mentions": {
      "type": "array",
      "items": {}
    },
    "effects": {
      "type": "array",
      "items": {}
    },
    "stickers": {
      "type": "array",
      "items": {}
    },
    "comments": {
      "$ref": "#/$defs/comments"
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pageUrl",
        "canonicalUrl",
        "itemSource",
        "topLevelKeys"
      ],
      "properties": {
        "pageUrl": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "itemSource": {
          "type": "string"
        },
        "topLevelKeys": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "canonicalUrl",
        "shareUrl",
        "embedUrl",
        "title",
        "description",
        "createTime",
        "publishedAt",
        "publishedDate",
        "regionCode",
        "duration",
        "width",
        "height",
        "ratio",
        "coverUrl",
        "dynamicCoverUrl",
        "originCoverUrl",
        "playbackUrl",
        "downloadUrl",
        "isAigc",
        "isStemVerified",
        "voiceToText",
        "playlistId",
        "labels",
        "tags"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string"
        },
        "shareUrl": {
          "type": "string"
        },
        "embedUrl": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createTime": {
          "type": [
            "string",
            "integer"
          ]
        },
        "publishedAt": {
          "type": "string"
        },
        "publishedDate": {
          "type": "string"
        },
        "regionCode": {
          "type": "string"
        },
        "duration": {
          "type": "number"
        },
        "width": {
          "type": "number"
        },
        "height": {
          "type": "number"
        },
        "ratio": {
          "type": "string"
        },
        "coverUrl": {
          "type": "string"
        },
        "dynamicCoverUrl": {
          "type": "string"
        },
        "originCoverUrl": {
          "type": "string"
        },
        "playbackUrl": {
          "type": "string"
        },
        "downloadUrl": {
          "type": "string"
        },
        "isAigc": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "isStemVerified": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "voiceToText": {
          "type": "string"
        },
        "playlistId": {
          "type": "string"
        },
        "labels": {
          "type": "array",
          "items": {}
        },
        "tags": {
          "type": "array",
          "items": {}
        }
      }
    },
    "videoStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewCount",
        "likeCount",
        "commentCount",
        "shareCount",
        "favoriteCount"
      ],
      "properties": {
        "viewCount": {
          "type": "integer"
        },
        "likeCount": {
          "type": "integer"
        },
        "commentCount": {
          "type": "integer"
        },
        "shareCount": {
          "type": "integer"
        },
        "favoriteCount": {
          "type": "integer"
        }
      }
    },
    "author": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "secUid",
        "username",
        "nickname",
        "signature",
        "verified",
        "privateAccount",
        "avatarUrl",
        "stats"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "secUid": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "signature": {
          "type": "string"
        },
        "verified": {
          "type": "boolean"
        },
        "privateAccount": {
          "type": "boolean"
        },
        "avatarUrl": {
          "type": "string"
        },
        "stats": {
          "$ref": "#/$defs/authorStats"
        }
      }
    },
    "authorStats": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "followerCount",
        "followingCount",
        "friendCount",
        "heartCount",
        "videoCount",
        "diggCount"
      ],
      "properties": {
        "followerCount": {
          "type": "integer"
        },
        "followingCount": {
          "type": "integer"
        },
        "friendCount": {
          "type": "integer"
        },
        "heartCount": {
          "type": "integer"
        },
        "videoCount": {
          "type": "integer"
        },
        "diggCount": {
          "type": "integer"
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "author",
        "album",
        "original",
        "duration",
        "coverUrl",
        "playUrl"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "album": {
          "type": "string"
        },
        "original": {
          "type": "boolean"
        },
        "duration": {
          "type": "number"
        },
        "coverUrl": {
          "type": "string"
        },
        "playUrl": {
          "type": "string"
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "loadedCount",
        "reportedCount",
        "note",
        "items"
      ],
      "properties": {
        "loadedCount": {
          "type": "integer"
        },
        "reportedCount": {
          "type": "integer"
        },
        "note": {
          "type": "string"
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/commentItem"
          }
        }
      }
    },
    "commentItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "commentId",
        "videoId",
        "parentCommentId",
        "username",
        "handle",
        "userId",
        "avatarUrl",
        "comment",
        "postedAt",
        "createTime",
        "createdAt",
        "postedDate",
        "likeCount",
        "replyCount"
      ],
      "properties": {
        "level": {
          "type": "integer"
        },
        "commentId": {
          "type": "string"
        },
        "videoId": {
          "type": "string"
        },
        "parentCommentId": {
          "type": "string"
        },
        "username": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "userId": {
          "type": "string"
        },
        "avatarUrl": {
          "type": "string"
        },
        "comment": {
          "type": "string"
        },
        "postedAt": {
          "type": "string"
        },
        "createTime": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "createdAt": {
          "type": "string"
        },
        "postedDate": {
          "type": "string"
        },
        "likeCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "replyCount": {
          "type": [
            "integer",
            "null"
          ]
        }
      }
    }
  }
}
